# ── PostgreSQL ────────────────────────
DB_NAME=iye-db
DB_USER=iye-user
DB_PASSWORD=CAMBIAR_password_seguro

# ── Keycloak (Docker) ─────────────────
KC_DB_NAME=keycloak
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=CAMBIAR_password_admin

# ── Keycloak (Spring Boot) ────────────
# URL base del realm. Debe coincidir con el issuer del JWT.
# En dev local: http://localhost:8180/realms/iye
KC_ISSUER_URI=http://localhost:8180/realms/iye

# ── CORS (frontend React) ─────────────
# Origen(es) permitidos separados por coma.
# En dev local: http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ── Cifrado de datos sensibles ─────────
# Clave maestra AES-256 en base64 (32 bytes). En producción DEBE venir de un
# secret manager y NUNCA quedar hardcodeada. Generar con: openssl rand -base64 32
ENC_KEY=n+WPGF8DECxYtC80EBZur9WDZIZS3reCBLNB9zJ3ZVU=
# true → re-cifra datos existentes en claro (una sola vez al activar el cifrado).
ENC_MIGRATE=false

# ── Evolution API ───────────────────────
# URL local (en Docker-compose es interna, pero desde el host será 8081)
EVOLUTION_API_URL=http://localhost:8081
EVOLUTION_API_KEY=clave_secreta_123
EVOLUTION_API_INSTANCE=mi_whatsapp

# ── Backup (contenedor iye-backup) ──────
# Expresión cron (5 campos). Default: todos los días a las 03:00.
BACKUP_CRON=0 3 * * *
# Copias a conservar por base antes de rotar.
BACKUP_RETENTION=30
# Cifrado AES-256 opcional (requiere openssl en la imagen, ver BACKUP_README.md).
BACKUP_CRYPT=false
# Clave/frase para cifrar los dumps (solo si BACKUP_CRYPT=true).
BACKUP_PASSWORD=