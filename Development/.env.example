# ── PostgreSQL ────────────────────────
DB_NAME=iye-db
DB_USER=iye-user
DB_PASSWORD=CAMBIAR_password_seguro

# ── Keycloak (Docker) ─────────────────
KC_DB_NAME=keycloak
KC_ADMIN_USER=admin
KC_ADMIN_PASSWORD=CAMBIAR_password_admin

# ── Keycloak (Spring Boot) ────────────
# URL base del realm. Debe coincidir con el issuer del JWT.
# En dev local: http://localhost:8180/realms/iye
KC_ISSUER_URI=http://localhost:8180/realms/iye

# ── CORS (frontend React) ─────────────
# Origen(es) permitidos separados por coma.
# En dev local: http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ── Evolution API ───────────────────────
# URL local (en Docker-compose es interna, pero desde el host será 8081)
EVOLUTION_API_URL=http://localhost:8081
EVOLUTION_API_KEY=clave_secreta_123
EVOLUTION_API_INSTANCE=mi_whatsapp