{
  "info": {
    "name": "Cronicotrak API",
    "description": "Colección de Postman para probar la API de Cronicotrak. Incluye la configuración de autenticación OAuth2 mediante Keycloak.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "oauth2",
    "oauth2": [
      {
        "key": "grant_type",
        "value": "authorization_code",
        "type": "string"
      },
      {
        "key": "tokenName",
        "value": "Keycloak Token",
        "type": "string"
      },
      {
        "key": "authUrl",
        "value": "{{keycloakBaseUrl}}/realms/{{realm}}/protocol/openid-connect/auth",
        "type": "string"
      },
      {
        "key": "accessTokenUrl",
        "value": "{{keycloakBaseUrl}}/realms/{{realm}}/protocol/openid-connect/token",
        "type": "string"
      },
      {
        "key": "clientId",
        "value": "{{clientId}}",
        "type": "string"
      },
      {
        "key": "scope",
        "value": "openid profile email",
        "type": "string"
      },
      {
        "key": "addTokenTo",
        "value": "header",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          ""
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          ""
        ]
      }
    }
  ],
  "item": [
    {
      "name": "1. Director",
      "description": "Endpoints compartidos con el Director para el panel de estadísticas y reportes.",
      "item": [
        {
          "name": "Listar Pacientes (Resumen)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/paciente/patients",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "paciente",
                "patients"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Detalle de un Paciente",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/paciente/detail/:id",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "paciente",
                "detail",
                ":id"
              ],
              "variable": [
                {
                  "key": "id",
                  "value": "2",
                  "description": "ID del paciente a consultar"
                }
              ]
            }
          },
          "response": []
