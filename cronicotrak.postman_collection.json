    {
      "name": "2. Nurse",
      "description": "Endpoints para Enfermero/a para el manejo directo de fichas médicas.",
      "item": [
        {
          "name": "Listar Pacientes (Resumen)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/paciente/patients",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "paciente",
                "patients"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Obtener Ficha Médica Completa",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/medical/record/:idPatient",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "medical",
                "record",
                ":idPatient"
              ],
              "variable": [
                {
                  "key": "idPatient",
                  "value": "5",
                  "description": "ID del paciente"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Actualizar Ficha Médica",
          "request": {
            "method": "PUT",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"idPatient\": 5,\n  \"name\": \"María García López\",\n  \"age\": 68,\n  \"status\": \"Controlado\",\n  \"lastVisit\": \"14/5/2026\",\n  \"nextVisit\": \"21/5/2026\",\n  \"room\": \"205\",\n  \"phone\": \"555-0102\",\n  \"mail\": \"maria.garcia@email.com\",\n  \"address\": \"Av. Principal 123, Santiago\",\n  \"bloodType\": \"O+\",\n  \"emergencyName\": \"Pedro García\",\n  \"emergencyPhone\": \"555-0102\",\n  \"alergies\": [\n    \"Penicilina\"\n  ],\n  \"actualMeds\": [\n    \"Metformina 850mg (2 veces al día)\",\n    \"Enalapril 10mg\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/medical/record/:idPatient",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "medical",
                "record",
                ":idPatient"
              ],
              "variable": [
                {
                  "key": "idPatient",
                  "value": "5"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Ocultar Ficha Médica (Soft Delete)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/medical/record/:idPatient",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "medical",
                "record",
                ":idPatient"
              ],
              "variable": [
                {
                  "key": "idPatient",
                  "value": "5"
                }
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. WhatsApp Integration",
      "description": "Endpoints para integración con Evolution API y envío de WhatsApp.",
      "item": [
        {
          "name": "Enviar Mensaje WhatsApp",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"numero\": \"56977020724\",\n  \"mensaje\": \"¡Hola, paciente! Este es un recordatorio de Cronicotrak. 🚀\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/whatsapp/send",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "whatsapp",
                "send"
              ]
            }
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "keycloakBaseUrl",
      "value": "http://localhost:8180",
      "type": "string"
    },
    {
      "key": "realm",
      "value": "iye",
      "type": "string"
    },
    {
      "key": "clientId",
      "value": "iye-backend",
      "type": "string"
    }
  ]
